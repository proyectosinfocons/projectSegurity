<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================= MAPA ================= -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ================= BOTÓN FILTROS ================= -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnFiltros"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:contentDescription="Filtros"
        android:src="@android:drawable/ic_menu_search"
        android:tint="#FFFFFF"
        app:backgroundTint="#1976D2" />

    <!-- ================= BOTÓN MI UBICACIÓN ================= -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnMiUbicacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="90dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Mi ubicación"
        android:src="@android:drawable/ic_menu_mylocation"
        android:tint="#FFFFFF"
        app:backgroundTint="#0288D1" />

    <!-- ===================================================== -->
    <!-- BOTÓN IR A ZONA SEGURA -->
    <!-- ===================================================== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnZonaSegura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="165dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Zona Segura"
        android:src="@android:drawable/ic_dialog_map"
        android:tint="#FFFFFF"
        app:backgroundTint="#388E3C" />






    <!-- ===================================================== -->
    <!-- BOTÓN LEYENDA -->
    <!-- ===================================================== -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnLeyenda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="240dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Leyenda"
        android:src="@android:drawable/ic_dialog_info"
        android:tint="#FFFFFF"
        app:backgroundTint="#455A64" />

    <!-- ================= PANEL SUPERIOR ================= -->
    <LinearLayout
        android:id="@+id/panelFiltros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="12dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Filtros por zona"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCerrarFiltros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="✕"
                android:textColor="#000000"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- ================= DISTRITO ================= -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/spinnerDistrito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Buscar distrito"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ================= ZONA ================= -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/spinnerZona"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Buscar zona o calle"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- ===================== CONTENEDOR BOTONES ===================== -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="60dp"
        android:paddingTop="12dp"
        android:paddingEnd="60dp"
        android:paddingBottom="20dp">

        <!-- BOTÓN SALIR -->
        <Button
            android:id="@+id/btnSalirMapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#D32F2F"
            android:elevation="8dp"
            android:text="Salir"
            android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- ===================================================== -->
    <!-- LEYENDA DEL MAPA -->
    <!-- ===================================================== -->
    <ScrollView
        android:id="@+id/layoutLeyenda"
        android:visibility="gone"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="90dp"
        android:background="#CCFFFFFF"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Leyenda"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#000000"
                android:paddingBottom="8dp" />

            <!-- ZONAS SEGURAS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zonas seguras"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔹 Comisarías (Verde Oscuro)"
                android:textColor="#1B5E20" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔹 Casetas de Serenazgo (Verde Menta Oscuro)"
                android:textColor="#1ABC9C" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔹 Municipalidades (Verde Claro)"
                android:textColor="#8BC34A" />

            <!-- REPORTES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Casos reportados"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔹 Reportes delictivos (Naranja)"
                android:textColor="#FF6F00" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔹 Botón de pánico (Rojo)"
                android:textColor="#D50000" />

            <!-- PUNTOS GENÉRICOS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Puntos genéricos"
                android:textStyle="bold"
                android:textColor="#000000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔹 Distrito seleccionado (Azul claro)"
                android:textColor="#29B6F6" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔹 Avenida seleccionada (Morado)"
                android:textColor="#6A1B9A" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔹 Ubicación actual (Azul Intenso)"
                android:textColor="#1565C0" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>