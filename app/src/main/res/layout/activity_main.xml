<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".MainActivity">

    <!-- Barra superior roja con el texto INICIO -->
    <TextView
        android:id="@+id/tvInicio"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center"
        android:background="#D32F2F"
        android:text="INICIO"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="20sp" />

    <!-- Título -->
    <TextView
        android:id="@+id/tvReportar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_gravity="center_horizontal"
        android:text="Reportar delito"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/black" />

    <!-- Campo descripción -->
    <EditText
        android:id="@+id/etDescripcion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Descripción del delito"
        android:layout_margin="16dp"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        android:inputType="textMultiLine" />

    <!-- Botón con ícono cámara -->
    <Button
        android:id="@+id/btnFoto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:drawableLeft="@android:drawable/ic_menu_camera"
        android:drawablePadding="8dp"
        android:text="Agregar foto/video"
        android:padding="12dp"
        android:backgroundTint="#F44336"
        android:textColor="@android:color/white" />

    <!-- TextView para mostrar mensaje de archivo capturado -->
    <TextView
        android:id="@+id/tvFotoCapturada"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#000000"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- 🌍 Mapa de referencia real -->
    <fragment
        android:id="@+id/mapFragment"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_margin="16dp"
        tools:context=".MainActivity" />

    <!-- Botón Registrar debajo del mapa -->
    <Button
        android:id="@+id/btnRegistrar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="Registrar"
        android:padding="12dp"
        android:backgroundTint="#4CAF50"
        android:textColor="@android:color/white" />

</LinearLayout>
